# ---------------------------------------------------------------------------
# Opportunity Analyzer AI — environment configuration
#
# Every value below is optional unless marked REQUIRED. The application is
# deliberately runnable with no external keys at all: it falls back to SQLite,
# a deterministic profiler/matcher, and an offline local catalogue for search.
# Each fallback is reported to the user rather than being presented as the
# real thing.
# ---------------------------------------------------------------------------

# --- Security (REQUIRED in any non-local deployment) -----------------------
# HMAC key that signs the session cookie. SESSION_SECRET wins; AUTH_SECRET is an
# accepted alias. If neither is set the app boots with a fixed development key
# and /api/health reports a warning — never deploy that way. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
AUTH_SECRET=
# AES-256-GCM key used to encrypt stored resumes and TOTP secrets at rest. Use a long random
# value, e.g. `openssl rand -hex 32`; it is hashed, not stretched, so a short passphrase is weak
# (/api/health warns below 32 characters). If unset, resumes are stored unencrypted and the app
# says so. Losing or changing the key makes existing encrypted resumes unreadable.
ENCRYPTION_KEY=

# --- Database --------------------------------------------------------------
# A postgres:// URL selects the PostgreSQL driver. Leave unset to use the
# bundled SQLite driver at data/app.db.
DATABASE_URL=
SQLITE_DIR=data
PG_SSL=false
PG_POOL_MAX=10

# --- Settings an administrator can also change in the app ------------------------
# Admin > Configuration edits these without a restart. PRECEDENCE: if the environment variable
# below is set (and valid) it WINS and locks the setting in the admin panel; otherwise the value
# saved in the admin panel applies; otherwise the built-in default. So leave a variable unset if
# you want to manage that setting from the UI.
#   AI_PROVIDER, AI_PROVIDER_ORDER, AI_MAX_DAILY_CALLS
#   SEARCH_PROVIDER_ORDER, SEARCH_MAX_PROVIDERS, SEARCH_QUERIES_PER_ANALYSIS
#   RATE_LIMIT_LOGIN, VERIFICATION_RECHECK_HOURS, DIGEST_HOUR_LOCAL
# (Default match weights and "require MFA for administrators" are admin-panel only.)

# --- AI provider -----------------------------------------------------------
# Any of: openai | anthropic | gemini | none | auto
# "auto" (default) tries providers in AI_PROVIDER_ORDER and uses the first one
# that is configured. With no key at all the app uses deterministic heuristics
# and says so.
AI_PROVIDER=auto
AI_PROVIDER_ORDER=openai,anthropic,gemini
# Successful AI calls one user may trigger per 24 hours; beyond it the local engine answers.
AI_MAX_DAILY_CALLS=200
AI_TIMEOUT_MS=30000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_ORG_ID=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_BASE_URL=

# Either GOOGLE_AI_API_KEY or GEMINI_API_KEY is accepted.
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=

# --- Web search ------------------------------------------------------------
# Any of: auto | tavily | serper | brave | bing | searxng | none
# With no key the app searches its own seeded catalogue ("local-catalog") and
# labels results accordingly.
SEARCH_PROVIDER=auto
SEARCH_PROVIDER_ORDER=tavily,serper,brave,bing,searxng
SEARCH_MAX_PROVIDERS=2
SEARCH_QUERIES_PER_ANALYSIS=18
SEARCH_TIMEOUT_MS=20000
# Searches per user per hour.
SEARCH_RATE_LIMIT=12

TAVILY_API_KEY=
TAVILY_DEPTH=advanced
SERPER_API_KEY=
SERPER_GL=in
BRAVE_API_KEY=
BRAVE_COUNTRY=IN
BING_API_KEY=
SEARXNG_URL=

# --- Fetching / crawling ---------------------------------------------------
# robots.txt is always checked, and an unreachable robots.txt means "do not
# fetch" (fail closed). ROBOTS_AGENT defaults to the full user-agent string; a
# site's `User-agent: OpportunityAnalyzerAI` group matches it by substring.
# Put a real contact URL in the user agent before crawling anything.
FETCH_USER_AGENT=OpportunityAnalyzerAI/1.0 (+career-intelligence-bot; respects robots.txt)
# ROBOTS_AGENT=
FETCH_TIMEOUT_MS=15000

# --- Uploads ---------------------------------------------------------------
# Where resume files are stored (absolute, or relative to the working directory). Put this on a
# mounted volume in a container. Files are never served directly; downloads are owner-checked.
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=10485760
# Optional ClamAV daemon for malware scanning. When unreachable the scan is
# reported as "unavailable" — it is never faked as passed.
CLAMD_HOST=
CLAMD_PORT=3310

# --- Reverse proxy ----------------------------------------------------------
# How many reverse proxies (nginx, a load balancer, a CDN) sit in front of the app. The client
# IP used for rate limits and the audit log is then taken from the matching position in
# X-Forwarded-For, counted from the right — the part your proxies wrote, not the part a client
# can forge. Leave at 0 only if clients connect directly; there the header is forgeable, so the
# IP is advisory and the per-account lockout is what stops password guessing.
TRUST_PROXY_HOPS=0

# --- Embedding ---------------------------------------------------------------
# Who may show the app inside a frame. Default `none` (clickjacking protection). Use `self`,
# a list of origins (https://portal.example.com), or `*` for a preview environment. Write the
# keywords WITHOUT quotes. READ AT BUILD TIME (Next compiles headers into the build).
FRAME_ANCESTORS=none
# `lax` (default) for a normal deployment. `none` ONLY when the app runs inside another site's
# frame: it needs HTTPS and marks cookies Secure + Partitioned. CSRF stays defended by the
# x-csrf-token header.
COOKIE_SAMESITE=lax

# --- Sessions & rate limiting ----------------------------------------------
SESSION_TTL_DAYS=7
ADMIN_SESSION_TTL_DAYS=1
# Login attempts per IP per 15 minutes.
RATE_LIMIT_LOGIN=10
# Longest time, in hours, before a record is due for re-checking (deadline-critical records are
# re-checked sooner regardless). The hour of day (IST) from which daily digests are created.
VERIFICATION_RECHECK_HOURS=72
DIGEST_HOUR_LOCAL=8

# --- Email (deadline alerts and digests) -----------------------------------
# EMAIL_PROVIDER:
#   smtp     real delivery through SMTP_HOST (implemented with nodemailer)
#   console  prints each email to the server log; for development, sends nothing
#   (empty)  email disabled
# With no provider, alerts still appear in the app, nothing is queued for email and nothing is
# ever marked as sent. Settings shows users that email is unavailable.
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465). Left empty it is inferred from the port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Opportunity Analyzer <no-reply@localhost>
# Public base URL, used to build the links inside emails.
APP_BASE_URL=http://localhost:3000

# --- Scheduled sweeps ------------------------------------------------------
# A scheduler (cron, systemd timer, your platform's scheduler) should call, e.g. every 30 min:
#   curl -X POST $APP_BASE_URL/api/notifications/sweep -H "x-cron-secret: $CRON_SECRET"
# It generates deadline alerts and daily/weekly digests and delivers queued email. Without it,
# in-app deadline alerts are still generated whenever a user opens the app.
# Unset = the header path is closed entirely (an MFA-verified operator can still trigger it).
CRON_SECRET=

# --- Seed accounts ---------------------------------------------------------
# Change these. They are printed by the seeder and only exist after db:seed.
SEED_ADMIN_PASSWORD=ChangeMe!SuperAdmin2026
SEED_ANALYST_PASSWORD=ChangeMe!Analyst2026
SEED_RECRUITER_PASSWORD=ChangeMe!Recruiter2026
SEED_CANDIDATE_PASSWORD=ChangeMe!Candidate2026
